<section id="pedir" class="bg-vibrant-yellow px-4 py-20">
  <div
    class="mx-auto flex max-w-[1280px] flex-col items-center justify-between gap-8 rounded-feature-cards bg-cocoa-brown px-8 py-12 shadow-xl md:flex-row md:px-16"
  >
    <div class="text-center md:text-left">
      <h2
        class="font-sans-gustitos text-heading font-extrabold leading-tight text-neutral-white sm:text-[56px]"
