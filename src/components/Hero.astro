---
---

<section
  id="inicio"
  class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden bg-neutral-white px-4 pt-8 pb-20"
>
  {/* Decorative background blobs */}
  <div
    class="pointer-events-none absolute top-[10%] left-[5%] h-40 w-40 rounded-full bg-cream-vanilla/50 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute right-[5%] bottom-[15%] h-48 w-48 rounded-full bg-pastel-lilac/40 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute top-[30%] right-[15%] h-32 w-32 rounded-full bg-bubblegum-pink/40 blur-3xl"
  >
  </div>

  {/* Floating pastel wave floor divider */}
  <div
    class="pointer-events-none absolute right-0 bottom-0 left-0 z-[1] h-[260px] sm:h-[300px] md:h-[340px]"
    aria-hidden="true"
  >
    <img
      src="/olas-svg.svg"
      alt=""
      class="h-full w-full object-cover opacity-65"
    />
  </div>

  <div class="relative z-10 mx-auto max-w-[1280px] text-center">

    <h1
      class="text-gustitos-gradient font-sans-gustitos text-heading-lg font-extrabold leading-[0.85] tracking-tight sm:text-[120px] md:text-[140px] lg:text-[160px]"
    >
      GUSTITOS
    </h1>


    <h2
      class="font-sans-gustitos text-heading font-extrabold leading-[0.9] tracking-tight text-pastel-lilac sm:text-[48px] md:text-[60px] lg:text-[72px]"
    >
      Heladería & Refresquería
    </h2>

    <p class="mx-auto mt-6 max-w-xl text-body leading-relaxed text-cocoa-brown/80">
      Helados cremosos, conos crujientes, waffles calientitos y postres que te
      devuelven a los mejores momentos. Hechos a mano, servidos con una sonrisa.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#pedir"
        class="rounded-buttons bg-vibrant-yellow px-8 py-4 font-sans-gustitos text-body font-bold text-cocoa-brown shadow-lg transition-transform hover:scale-105 hover:shadow-xl"
      >
        Pide tu favorito
      </a>
      <a
        href="#productos"
        class="rounded-buttons border-2 border-cocoa-brown bg-transparent px-8 py-4 font-sans-gustitos text-body font-semibold text-cocoa-brown transition-colors hover:bg-cocoa-brown hover:text-neutral-white"
      >
        Ver menú
      </a>
    </div>
  </div>

  {/* Floating product images — background layer */}
  <img
    src="/cono_sinfondo.png"
    alt="Cono de helado"
    class="shadow-product absolute top-[10%] left-[1%] z-0 w-40 rotate-[-12deg] sm:left-[3%] sm:w-52 md:w-60 lg:w-72"
  />
  <img
    src="/sundae_sinfondo.png"
    alt="Sundae"
    class="shadow-product absolute top-[14%] right-[1%] z-0 w-44 rotate-[10deg] sm:right-[3%] sm:w-56 md:w-64 lg:w-72"
  />
</section>
