---
---

<section
  id="inicio"
  class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden bg-neutral-white px-4 pt-16 pb-28 sm:pt-20 sm:pb-32"
>
  {/* Decorative background blobs */}
  <div
    class="pointer-events-none absolute top-[8%] left-[5%] h-32 w-32 rounded-full bg-cream-vanilla/50 blur-3xl sm:h-40 sm:w-40"
  >
  </div>
  <div
    class="pointer-events-none absolute right-[5%] bottom-[12%] h-36 w-36 rounded-full bg-pastel-lilac/40 blur-3xl sm:h-48 sm:w-48"
  >
  </div>
  <div
    class="pointer-events-none absolute top-[25%] right-[10%] h-24 w-24 rounded-full bg-bubblegum-pink/40 blur-3xl sm:h-32 sm:w-32"
  >
  </div>

  {/* Floating pastel wave floor divider */}
  <div
    class="pointer-events-none absolute right-0 bottom-0 left-0 z-[1] h-[200px] sm:h-[260px] md:h-[300px] lg:h-[340px]"
    aria-hidden="true"
  >
    <img
      src="/olas-svg.svg"
      alt=""
      class="h-full w-full object-cover opacity-65"
    />
  </div>

  {/* Main content */}
  <div class="relative z-10 mx-auto w-full max-w-[1280px] px-2 text-center sm:px-4">
    <h1
      class="text-gustitos-gradient font-sans-gustitos text-[52px] font-extrabold leading-[0.85] tracking-tight sm:text-[90px] md:text-[120px] lg:text-[150px] xl:text-[170px]"
    >
      GUSTITOS
    </h1>

    <h2
      class="font-sans-gustitos text-[26px] font-extrabold leading-[0.9] tracking-tight text-pastel-lilac sm:text-[40px] md:text-[52px] lg:text-[64px]"
    >
      Heladería & Refresquería
    </h2>

    <p
      class="mx-auto mt-4 max-w-lg px-2 text-body-sm leading-relaxed text-cocoa-brown/80 sm:mt-6 sm:max-w-xl sm:px-0 sm:text-body"
    >
      Helados cremosos, conos crujientes, waffles calientitos y postres que te
      devuelven a los mejores momentos. Hechos a mano, servidos con una sonrisa.
    </p>

    <div
      class="mt-6 flex flex-col items-center justify-center gap-3 sm:mt-8 sm:flex-row sm:gap-4"
    >
      <a
        href="#pedir"
        class="rounded-buttons bg-vibrant-yellow px-7 py-3 font-sans-gustitos text-body-sm font-bold text-cocoa-brown shadow-lg transition-transform hover:scale-105 hover:shadow-xl sm:px-8 sm:py-4 sm:text-body"
      >
        Pide tu favorito
      </a>
      <a
        href="#productos"
        class="rounded-buttons border-2 border-cocoa-brown bg-transparent px-7 py-3 font-sans-gustitos text-body-sm font-semibold text-cocoa-brown transition-colors hover:bg-cocoa-brown hover:text-neutral-white sm:px-8 sm:py-4 sm:text-body"
      >
        Ver menú
      </a>
    </div>
  </div>

  {/* Floating product images — background layer */}
  <img
    src="/cono_sinfondo.png"
    alt="Cono de helado"
    class="shadow-product absolute top-[14%] left-[-3%] z-0 w-24 rotate-[-12deg] sm:left-[2%] sm:w-36 md:left-[4%] md:w-48 lg:w-60"
  />
  <img
    src="/sundae_sinfondo.png"
    alt="Sundae"
    class="shadow-product absolute top-[16%] right-[-3%] z-0 w-28 rotate-[10deg] sm:right-[2%] sm:w-40 md:right-[4%] md:w-52 lg:w-60"
  />
</section>
