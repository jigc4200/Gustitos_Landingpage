---
---

<section id="ubicacion" class="bg-neutral-white px-4 py-20">
  <div class="mx-auto max-w-[1280px]">
    <div class="mb-10 text-center">
      <span
        class="rounded-buttons bg-fresh-cyan px-4 py-1 font-sans-gustitos text-body-sm font-bold text-cocoa-brown"
      >
        Visítanos
      </span>
      <h2
        class="mt-4 font-sans-gustitos text-heading font-extrabold leading-tight text-cocoa-brown sm:text-[56px]"
      >
        Encuéntranos en Aguadulce
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-body text-cocoa-brown/80">
        Estamos listos para endulzar tu día. Pasa por nuestra tienda y disfruta
        de nuestros postres artesanales recién preparados.
      </p>
    </div>

    <div
      class="overflow-hidden rounded-cards shadow-lg"
    >
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1242.9121663091046!2d-80.54543154397064!3d8.250164994711298!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fadcf0050453daf%3A0x9af7a5e0332f9054!2sGustitos%20%7C%20Aguadulce!5e1!3m2!1ses-419!2spa!4v1787201047676!5m2!1ses-419!2spa"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title="Ubicación de Gustitos en Aguadulce"
        class="block w-full"
      ></iframe>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://maps.app.goo.gl/Ger78JqDMJmFGtxZ8"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-buttons bg-vibrant-yellow px-6 py-3 font-sans-gustitos text-body-sm font-bold text-cocoa-brown shadow-md transition-transform hover:scale-105"
      >
        Abrir en Google Maps
      </a>
    </div>
  </div>
</section>
