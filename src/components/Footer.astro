---
---

<footer id="contacto" class="bg-cocoa-brown px-4 py-16">
  <div class="mx-auto max-w-[1280px]">
    <div
      class="grid grid-cols-1 gap-12 border-b border-neutral-white/10 pb-12 sm:grid-cols-2 lg:grid-cols-4"
    >
      <div>
        <a href="#inicio" class="flex items-center gap-2">
          <img
            src="/gustitos_logo.png"
            alt=""
            class="h-12 w-auto object-contain"
          />
          <span
            class="font-sans-gustitos text-2xl font-bold tracking-wide text-neutral-white"
          >
            Gustitos
          </span>
        </a>
        <p class="mt-4 text-body-sm leading-relaxed text-neutral-white/70">
          Helados y postres artesanales que endulzan tus momentos especiales.
        </p>
      </div>

      <div>
        <h4
          class="font-sans-gustitos text-body font-bold tracking-wide text-neutral-white"
        >
          Explora
        </h4>
        <ul class="mt-4 space-y-2 text-body-sm text-neutral-white/70">
          <li><a href="#inicio" class="hover:text-fresh-cyan">Inicio</a></li>
          <li>
            <a href="#productos" class="hover:text-fresh-cyan">Productos</a>
          </li>
          <li>
            <a href="#nosotros" class="hover:text-fresh-cyan">Nosotros</a>
          </li>
          <li>
            <a href="#pedir" class="hover:text-fresh-cyan">Pedir ahora</a>
          </li>
        </ul>
      </div>

      <div>
        <h4
          class="font-sans-gustitos text-body font-bold tracking-wide text-neutral-white"
        >
          Contacto
        </h4>
        <ul class="mt-4 space-y-2 text-body-sm text-neutral-white/70">
          <li>Av. Dulce Sabor 123, Lima</li>
          <li>hola@gustitos.pe</li>
          <li>+51 999 888 777</li>
        </ul>
      </div>

      <div>
        <h4
          class="font-sans-gustitos text-body font-bold tracking-wide text-neutral-white"
        >
          Síguenos
        </h4>
        <div class="mt-4 flex gap-3">
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-white/10 text-neutral-white transition-colors hover:bg-fresh-cyan hover:text-cocoa-brown"
            aria-label="Instagram"
          >
            IG
          </a>
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-white/10 text-neutral-white transition-colors hover:bg-bubblegum-pink hover:text-cocoa-brown"
            aria-label="Facebook"
          >
            FB
          </a>
          <a
            href="#"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-neutral-white/10 text-neutral-white transition-colors hover:bg-vibrant-yellow hover:text-cocoa-brown"
            aria-label="TikTok"
          >
            TK
          </a>
        </div>
      </div>
    </div>

    <div
      class="mt-8 flex flex-col items-center justify-between gap-4 text-body-sm text-neutral-white/50 md:flex-row"
    >
      <p>&copy; {new Date().getFullYear()} Gustitos. Todos los derechos reservados.</p>
      <p>Hecho con mucho amor y azúcar.</p>
    </div>
  </div>
</footer>
