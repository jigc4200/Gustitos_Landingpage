---
const slides = [
  { src: '/01.webp', alt: 'Ambiente de Gustitos 1' },
  { src: '/03.webp', alt: 'Ambiente de Gustitos 2' },
  { src: '/04.webp', alt: 'Ambiente de Gustitos 3' },
];
---

<section id="nosotros" class="bg-cream-vanilla px-4 py-24">
  <div class="mx-auto grid max-w-[1280px] items-center gap-12 lg:grid-cols-2">
    <div class="relative">
      <div
        class="rounded-feature-cards overflow-hidden bg-pastel-lilac p-6 shadow-lg sm:p-8"
      >
        <div class="carousel relative overflow-hidden">
          <div
            class="carousel-track flex transition-transform duration-500 ease-out"
          >
            {
              slides.map((slide) => (
                <div class="carousel-slide flex w-full shrink-0 items-center justify-center">
                  <img
                    src={slide.src}
                    alt={slide.alt}
                    class="mx-auto aspect-[3/4] w-full max-w-[360px] rounded-cards object-cover object-center shadow-product sm:max-w-[420px]"
                  />
                </div>
              ))
            }
          </div>

          {/* Navigation arrows */}
          <button
            type="button"
            class="carousel-prev absolute top-1/2 left-3 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-neutral-white/90 text-cocoa-brown shadow-md transition-transform hover:scale-110 hover:bg-vibrant-yellow"
            aria-label="Imagen anterior"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="carousel-next absolute top-1/2 right-3 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-neutral-white/90 text-cocoa-brown shadow-md transition-transform hover:scale-110 hover:bg-vibrant-yellow"
            aria-label="Siguiente imagen"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>

          {/* Dots */}
          <div
            class="carousel-dots absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-2"
          >
            {
              slides.map((_, index) => (
                <button
                  type="button"
                  class="carousel-dot h-2.5 w-2.5 rounded-full bg-neutral-white/70 transition-all hover:bg-vibrant-yellow"
                  data-index={index}
                  aria-label={`Ir a la imagen ${index + 1}`}
                />
              ))
            }
          </div>
        </div>
      </div>
      <div
        class="absolute -right-4 -bottom-6 rounded-cards bg-vibrant-yellow px-5 py-3 shadow-md"
      >
        <p class="font-sans-gustitos text-body-sm font-bold text-cocoa-brown">
          Hecho a mano
        </p>
        <p class="font-sans-gustitos text-caption font-semibold text-cocoa-brown/80">
          100% artesanal
        </p>
      </div>
    </div>

    <div>
      <span
        class="rounded-buttons bg-fresh-cyan px-4 py-1 font-sans-gustitos text-body-sm font-bold text-cocoa-brown"
      >
        Sobre nosotros
      </span>
      <h2
        class="mt-4 font-sans-gustitos text-heading font-extrabold leading-tight text-cocoa-brown sm:text-[56px]"
      >
        Dulzura que se siente
      </h2>
      <p class="mt-6 text-body leading-relaxed text-cocoa-brown/80">
        En Gustitos creemos que los mejores recuerdos se comparten con un postre
        en la mano. Por eso elaboramos cada helado, waffle y malteada con
        ingredientes de calidad, recetas propias y un toque de alegría que no
        encontrarás en ningún otro lugar.
      </p>
      <ul class="mt-6 space-y-3 text-body text-cocoa-brown/80">
        <li class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-fresh-cyan"></span>
          Ingredientes frescos y naturales
        </li>
        <li class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-bubblegum-pink"></span>
          Recetas artesanales sin conservantes
        </li>
        <li class="flex items-center gap-3">
          <span class="h-2 w-2 rounded-full bg-vibrant-yellow"></span>
          Ambiente familiar y divertido
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  (function initCarousel() {
    const carousel = document.querySelector('.carousel');
    if (!carousel) return;

    const track = carousel.querySelector('.carousel-track') as HTMLElement;
    const prevBtn = carousel.querySelector('.carousel-prev') as HTMLButtonElement;
    const nextBtn = carousel.querySelector('.carousel-next') as HTMLButtonElement;
    const dots = Array.from(carousel.querySelectorAll('.carousel-dot'));

    const totalSlides = dots.length;
    let current = 0;
    let autoplayInterval: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      current = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-vibrant-yellow', i === current);
        dot.classList.toggle('bg-neutral-white/70', i !== current);
        dot.classList.toggle('w-6', i === current);
      });
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayInterval = setInterval(next, 4000);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    prevBtn?.addEventListener('click', () => {
      prev();
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      next();
      startAutoplay();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goTo(index);
        startAutoplay();
      });
    });

    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);

    goTo(0);
    startAutoplay();
  })();
</script>
